{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "CLI SVG editor — PJ1 Phase 1 (Software Design)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
